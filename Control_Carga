<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minuto 0 | Carga de Entrenamiento</title>
    <style>
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background-color: #11161a; 
            margin: 0; 
            padding: 20px; 
            color: #e0e0e0; 
            -webkit-tap-highlight-color: transparent; 
        }

        .container { 
            max-width: 600px; 
            margin: 20px auto; 
            background: #1a1f24; 
            padding: 35px 40px; 
            border-radius: 16px; 
            box-shadow: 0 10px 25px rgba(0,0,0,0.5); 
            box-sizing: border-box;
            border: 1px solid rgba(209, 168, 92, 0.15);
        }

        .logo-container {
            text-align: center;
            margin-bottom: 25px;
        }

        .logo-text {
            font-size: 28px;
            font-weight: 800;
            color: #d1a85c;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .logo-text span {
            color: #fff;
        }

        h1, h2 { 
            color: #d1a85c; 
            text-align: center; 
            margin-top: 0; 
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        p.subtitle { 
            text-align: center; 
            color: #a0a5aa; 
            font-size: 15px; 
            margin-bottom: 25px; 
        }
        
        .screen { 
            display: none; 
        }

        .screen.active-screen { 
            display: block; 
        }

        .form-group { 
            margin-bottom: 22px; 
        }

        label { 
            font-weight: 600; 
            display: block; 
            margin-bottom: 8px; 
            font-size: 15px; 
            color: #d1a85c;
        }

        input, select, textarea { 
            width: 100%; 
            padding: 14px; 
            border: 1px solid #3a4149; 
            border-radius: 8px; 
            box-sizing: border-box; 
            font-size: 16px; 
            background-color: #252b32; 
            color: #fff;
            font-family: inherit;
        }

        input:focus, select:focus, textarea:focus { 
            border-color: #d1a85c; 
            outline: none; 
            box-shadow: 0 0 0 3px rgba(209, 168, 92, 0.2); 
        }

        textarea {
            resize: vertical;
            min-height: 100px;
        }
        
        .btn { 
            background: #d1a85c; 
            color: #11161a; 
            border: none; 
            padding: 16px 20px; 
            font-size: 17px; 
            border-radius: 8px; 
            cursor: pointer; 
            width: 100%; 
            font-weight: bold; 
            transition: all 0.2s; 
            margin-top: 10px; 
            box-sizing: border-box;
            letter-spacing: 0.5px;
        }

        .btn:hover { 
            background: #bfa052; 
            transform: translateY(-1px);
        }

        .btn:disabled { 
            background: #4a515a; 
            color: #8a9199;
            cursor: not-allowed; 
            transform: none;
        }

        .btn-secondary { 
            background: #3a4149; 
            color: #e0e0e0;
            margin-top: 15px; 
        }

        .btn-secondary:hover { 
            background: #4e5661; 
        }

        .menu-grid { 
            display: grid; 
            grid-template-columns: 1fr; 
            gap: 15px; 
            margin-top: 25px; 
            margin-bottom: 20px;
        }

        .btn-menu { 
            background: #252b32; 
            color: #d1a85c; 
            border: 2px solid #d1a85c; 
            padding: 25px; 
            font-size: 18px; 
            border-radius: 12px; 
            cursor: pointer; 
            font-weight: bold; 
            text-align: center; 
            transition: all 0.2s;
            width: 100%;
        }

        .btn-menu:hover { 
            background: rgba(209, 168, 92, 0.1); 
            transform: translateY(-2px); 
        }

        .btn-menu .icon {
            display: block;
            font-size: 30px;
            margin-bottom: 8px;
        }

        .btn-menu .desc {
            display: block;
            font-size: 13px;
            font-weight: 400;
            color: #a0a5aa;
            margin-top: 4px;
        }

        .table-responsive { 
            overflow-x: auto; 
            margin-top: 20px; 
            border-radius: 8px;
            border: 1px solid #3a4149;
        }

        table { 
            width: 100%; 
            border-collapse: collapse; 
            font-size: 15px; 
            min-width: 350px; 
            background: #252b32;
        }

        th, td { 
            padding: 14px; 
            border: 1px solid #3a4149; 
            text-align: center; 
        }

        th { 
            background-color: #1a1f24; 
            color: #d1a85c; 
            font-weight: 600; 
        }

        td strong {
            color: #d1a85c;
        }

        td.comment-td {
            text-align: left;
            font-size: 14px;
            color: #cbd5e1;
            max-width: 200px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        td.comment-td:hover {
            white-space: normal;
            word-break: break-word;
        }
        
        .alert { 
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 9999;
            max-width: 500px;
            width: 90%;
            background: #2e7d32; 
            color: #fff; 
            padding: 14px; 
            border-radius: 8px; 
            display: none; 
            text-align: center; 
            font-weight: bold; 
            font-size: 16px; 
            box-shadow: 0 4px 15px rgba(0,0,0,0.4);
        }

        .loading-text { 
            text-align: center; 
            color: #a0a5aa; 
            font-style: italic; 
            margin: 20px 0; 
            font-size: 16px; 
        }

        .welcome-box { 
            background: rgba(209, 168, 92, 0.1); 
            padding: 15px; 
            border-radius: 8px; 
            text-align: center; 
            font-size: 18px; 
            font-weight: bold; 
            color: #d1a85c; 
            margin-bottom: 20px; 
            border: 1px solid rgba(209, 168, 92, 0.2);
        }

        /* RPE slider */
        .rpe-display {
            text-align: center;
            font-size: 52px;
            font-weight: 800;
            color: #d1a85c;
            line-height: 1;
            margin: 10px 0 4px;
            transition: color 0.3s;
        }

        .rpe-label {
            text-align: center;
            font-size: 13px;
            color: #a0a5aa;
            margin-bottom: 12px;
        }

        input[type="range"] {
            -webkit-appearance: none;
            appearance: none;
            height: 8px;
            border-radius: 4px;
            background: #3a4149;
            padding: 0;
            border: none;
            cursor: pointer;
        }

        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: #d1a85c;
            cursor: pointer;
            border: 3px solid #1a1f24;
            box-shadow: 0 2px 6px rgba(0,0,0,0.4);
        }

        input[type="range"]:focus {
            box-shadow: none;
            border: none;
        }

        .rpe-ticks {
            display: flex;
            justify-content: space-between;
            padding: 4px 2px 0;
            font-size: 12px;
            color: #6a717a;
        }

        .tipo-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 6px;
        }

        .tipo-btn {
            background: #252b32;
            color: #a0a5aa;
            border: 2px solid #3a4149;
            padding: 18px 10px;
            font-size: 15px;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            text-align: center;
            transition: all 0.2s;
        }

        .tipo-btn .tipo-icon {
            display: block;
            font-size: 24px;
            margin-bottom: 6px;
        }

        .tipo-btn.selected {
            background: rgba(209, 168, 92, 0.12);
            color: #d1a85c;
            border-color: #d1a85c;
        }

        .tipo-btn:hover {
            border-color: #d1a85c;
            color: #d1a85c;
        }

        .evolucion-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .tab-btn {
            flex: 1;
            background: #252b32;
            color: #a0a5aa;
            border: 2px solid #3a4149;
            padding: 12px;
            font-size: 14px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.2s;
        }

        .tab-btn.active {
            background: rgba(209, 168, 92, 0.12);
            color: #d1a85c;
            border-color: #d1a85c;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .empty-state {
            text-align: center;
            color: #6a717a;
            padding: 40px 20px;
            font-size: 15px;
        }

        .empty-state .empty-icon {
            font-size: 40px;
            margin-bottom: 12px;
        }

        .rpe-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 15px;
        }

        .divider {
            border: none;
            border-top: 1px solid #3a4149;
            margin: 25px 0;
        }

        @media (max-width: 480px) {
            .container {
                padding: 25px 20px;
            }
        }

        .pin-dots {
            display: flex;
            justify-content: center;
            gap: 16px;
            margin: 20px 0;
        }
        .pin-dot {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: 2px solid #d1a85c;
            background: transparent;
            transition: background 0.15s;
        }
        .pin-dot.filled {
            background: #d1a85c;
        }
        .pin-keypad {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-top: 10px;
        }
        .pin-key {
            background: #252b32;
            color: #e0e0e0;
            border: 1px solid #3a4149;
            border-radius: 10px;
            padding: 18px 10px;
            font-size: 22px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s;
            text-align: center;
        }
        .pin-key:hover, .pin-key:active {
            background: rgba(209, 168, 92, 0.15);
            border-color: #d1a85c;
            color: #d1a85c;
        }
        .pin-error {
            text-align: center;
            color: #ef5350;
            font-size: 14px;
            min-height: 20px;
            margin-top: 8px;
            font-weight: 600;
        }
        .pin-jugador-name {
            text-align: center;
            font-size: 20px;
            font-weight: 700;
            color: #d1a85c;
            margin-bottom: 4px;
        }
    </style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
</head>
<body>

<div class="alert" id="alert-box"></div>

<div class="container">

        <div class="logo-container">
        <div class="logo-text">Minuto <span>0</span></div>
    </div>

    <!-- ══════════════════════════════════════
         PANTALLA 1 — SELECCIÓN DE JUGADOR
    ══════════════════════════════════════ -->
    <div class="screen active-screen" id="screen-login">
        <h1>Bienvenido</h1>
        <p class="subtitle">Selecciona tu nombre para continuar</p>

        <div class="form-group">
            <label for="select-jugador">👤 Jugador</label>
            <select id="select-jugador">
                <option value="">— Elige tu nombre —</option>
                <option value="Lara">Lara</option>
                <option value="Dani">Dani</option>
                <option value="Hugo">Hugo</option>
                <option value="Roberto">Roberto</option>
                <option value="Brais">Brais</option>
                <option value="Iker">Iker</option>
            </select>
        </div>

        <button class="btn" onclick="entrar()">Entrar →</button>
    </div>

    <!-- PANTALLA PIN -->
    <div class="screen" id="screen-pin">
        <h1>🔐 Código de acceso</h1>
        <p class="subtitle">Introduce tu PIN personal</p>
        <div class="pin-jugador-name" id="pin-jugador-name"></div>
        <div class="pin-dots" id="pin-dots">
            <div class="pin-dot" id="dot-0"></div>
            <div class="pin-dot" id="dot-1"></div>
            <div class="pin-dot" id="dot-2"></div>
            <div class="pin-dot" id="dot-3"></div>
        </div>
        <div class="pin-error" id="pin-error"></div>
        <div class="pin-keypad">
            <button class="pin-key" onclick="pinTecla('1')">1</button>
            <button class="pin-key" onclick="pinTecla('2')">2</button>
            <button class="pin-key" onclick="pinTecla('3')">3</button>
            <button class="pin-key" onclick="pinTecla('4')">4</button>
            <button class="pin-key" onclick="pinTecla('5')">5</button>
            <button class="pin-key" onclick="pinTecla('6')">6</button>
            <button class="pin-key" onclick="pinTecla('7')">7</button>
            <button class="pin-key" onclick="pinTecla('8')">8</button>
            <button class="pin-key" onclick="pinTecla('9')">9</button>
            <button class="pin-key" style="visibility:hidden"></button>
            <button class="pin-key" onclick="pinTecla('0')">0</button>
            <button class="pin-key" onclick="pinBorrar()">⌫</button>
        </div>
        <button class="btn btn-secondary" style="margin-top:20px;" onclick="irA('screen-login')">← Volver</button>
    </div>

    <!-- ══════════════════════════════════════
         PANTALLA 2 — MENÚ PRINCIPAL
    ══════════════════════════════════════ -->
    <div class="screen" id="screen-menu">
        <div class="welcome-box" id="welcome-box">Hola, —</div>
        <h2>¿Qué quieres hacer?</h2>
        <div class="menu-grid">
            <button class="btn-menu" onclick="irA('screen-registro')">
                <span class="icon">📝</span>
                Registrar sesión
                <span class="desc">Anota el RPE y el CMJ de hoy</span>
            </button>
            <button class="btn-menu" onclick="irA('screen-evolucion'); cargarEvolucion()">
                <span class="icon">📈</span>
                Ver evolución
                <span class="desc">Consulta tu historial de cargas y saltos</span>
            </button>
        </div>
        <button class="btn btn-secondary" onclick="cerrarSesion()">← Cambiar jugador</button>
    </div>

    <!-- ══════════════════════════════════════
         PANTALLA 3 — REGISTRO DE SESIÓN
    ══════════════════════════════════════ -->
    <div class="screen" id="screen-registro">
        <h2>📝 Registrar sesión</h2>
        <p class="subtitle" id="registro-subtitle"></p>

        <div class="form-group">
            <label>Tipo de sesión</label>
            <div class="tipo-grid" style="grid-template-columns:1fr 1fr 1fr;">
                <button class="tipo-btn" id="btn-campo" onclick="seleccionarTipo('campo')">
                    <span class="tipo-icon">⚽</span>Campo
                </button>
                <button class="tipo-btn" id="btn-gym" onclick="seleccionarTipo('gym')">
                    <span class="tipo-icon">🏋️</span>Gimnasio
                </button>
                <button class="tipo-btn" id="btn-partido" onclick="seleccionarTipo('partido')">
                    <span class="tipo-icon">🏆</span>Partido
                </button>
            </div>
            <!-- Campos extra para partido -->
            <div id="partido-extra" style="display:none;margin-top:12px;">
                <div class="form-group" style="margin-bottom:12px;">
                    <label>⏱️ Minutos jugados</label>
                    <input type="number" id="input-minutos" placeholder="Ej: 90" min="0" max="120" step="1">
                </div>
            </div>
        </div>

        <div class="form-group">
            <label>📅 Fecha</label>
            <input type="date" id="input-fecha">
        </div>

        <div class="form-group">
            <label>💪 RPE percibido <small style="color:#a0a5aa;font-weight:400;">(esfuerzo 0–10)</small></label>
            <div class="rpe-display" id="rpe-display">5</div>
            <div class="rpe-label" id="rpe-texto">Moderado</div>
            <input type="range" id="input-rpe" min="0" max="10" step="1" value="5" oninput="actualizarRPE(this.value)">
            <div class="rpe-ticks">
                <span>0</span><span>1</span><span>2</span><span>3</span><span>4</span>
                <span>5</span><span>6</span><span>7</span><span>8</span><span>9</span><span>10</span>
            </div>
        </div>

        <div class="form-group">
            <label>📏 CMJ <small style="color:#a0a5aa;font-weight:400;">(centímetros)</small></label>
            <input type="number" id="input-cmj" placeholder="Ej: 42" min="0" max="100" step="0.1">
        </div>

        <div class="form-group">
            <label>💬 Observaciones <small style="color:#a0a5aa;font-weight:400;">(opcional)</small></label>
            <textarea id="input-obs" placeholder="¿Cómo te has sentido hoy?"></textarea>
        </div>

        <button class="btn" onclick="guardarSesion()">✅ Guardar sesión</button>
        <button class="btn btn-secondary" onclick="irA('screen-menu')">← Volver al menú</button>
    </div>

    <!-- ══════════════════════════════════════
         PANTALLA 4 — EVOLUCIÓN
    ══════════════════════════════════════ -->
    <div class="screen" id="screen-evolucion">
        <h2>📈 Mi evolución</h2>
        <p class="subtitle" id="evolucion-subtitle"></p>

        <div class="evolucion-tabs" style="flex-wrap:wrap;">
            <button class="tab-btn active" id="tab-rpe-btn" onclick="cambiarTab('rpe')">💪 RPE</button>
            <button class="tab-btn" id="tab-cmj-btn" onclick="cambiarTab('cmj')">📏 CMJ</button>
            <button class="tab-btn" id="tab-partido-btn" onclick="cambiarTab('partido')">🏆 Partidos</button>
        </div>

        <!-- Tab RPE -->
        <div class="tab-content active" id="tab-rpe">
            <canvas id="chart-rpe" style="width:100%;max-height:220px;margin-bottom:16px;"></canvas>
            <div id="tabla-rpe-container"></div>
        </div>

        <!-- Tab CMJ -->
        <div class="tab-content" id="tab-cmj">
            <canvas id="chart-cmj" style="width:100%;max-height:220px;margin-bottom:16px;"></canvas>
            <div id="tabla-cmj-container"></div>
        </div>

        <!-- Tab Partidos -->
        <div class="tab-content" id="tab-partido">
            <div id="tabla-partido-container"></div>
        </div>

        <button class="btn btn-secondary" onclick="irA('screen-menu')">← Volver al menú</button>
    </div>

</div><!-- /container -->

<script>
// ═══════════════════════════════════════════════
// ESTADO Y DATOS
// ═══════════════════════════════════════════════
let jugadorActual = '';
let tipoSesion = '';
let pinEntrada = '';

const PINES = {
    'Lara':    '1111',
    'Dani':    '2222',
    'Hugo':    '3333',
    'Roberto': '4444',
    'Brais':   '5555',
    'Iker':    '6666',
};

const RPE_LABELS = [
    'Reposo total', 'Muy muy suave', 'Muy suave', 'Suave',
    'Moderado-suave', 'Moderado', 'Moderado-duro', 'Duro',
    'Muy duro', 'Muy muy duro', 'Esfuerzo máximo'
];

const RPE_COLORS = [
    '#4caf50','#66bb6a','#9ccc65','#d4e157',
    '#ffee58','#ffa726','#ff7043','#ef5350',
    '#e53935','#c62828','#b71c1c'
];

// ═══════════════════════════════════════════════
// ALMACENAMIENTO LOCAL
// ═══════════════════════════════════════════════
function getSesiones() {
    return JSON.parse(localStorage.getItem('minuto0_sesiones') || '[]');
}

function saveSesiones(data) {
    localStorage.setItem('minuto0_sesiones', JSON.stringify(data));
}

// ═══════════════════════════════════════════════
// NAVEGACIÓN
// ═══════════════════════════════════════════════
function irA(screenId) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active-screen'));
    document.getElementById(screenId).classList.add('active-screen');
    window.scrollTo(0, 0);
}

// ═══════════════════════════════════════════════
// PANTALLA 1 — LOGIN
// ═══════════════════════════════════════════════
function entrar() {
    const sel = document.getElementById('select-jugador');
    if (!sel.value) { mostrarAlerta('Por favor, selecciona tu nombre.', 'error'); return; }
    pinEntrada = '';
    actualizarDots();
    document.getElementById('pin-error').textContent = '';
    document.getElementById('pin-jugador-name').textContent = sel.value;
    irA('screen-pin');
}

function cerrarSesion() {
    jugadorActual = '';
    tipoSesion = '';
    pinEntrada = '';
    document.getElementById('select-jugador').value = '';
    irA('screen-login');
}

function pinTecla(digito) {
    if (pinEntrada.length >= 4) return;
    pinEntrada += digito;
    actualizarDots();
    if (pinEntrada.length === 4) setTimeout(verificarPin, 150);
}

function pinBorrar() {
    pinEntrada = pinEntrada.slice(0, -1);
    actualizarDots();
    document.getElementById('pin-error').textContent = '';
}

function actualizarDots() {
    for (let i = 0; i < 4; i++) {
        document.getElementById('dot-' + i).classList.toggle('filled', i < pinEntrada.length);
    }
}

function verificarPin() {
    const jugador = document.getElementById('select-jugador').value;
    if (pinEntrada === PINES[jugador]) {
        jugadorActual = jugador;
        document.getElementById('welcome-box').textContent = '¡Hola, ' + jugadorActual + '! 👋';
        irA('screen-menu');
    } else {
        document.getElementById('pin-error').textContent = '❌ PIN incorrecto. Inténtalo de nuevo.';
        setTimeout(() => { pinEntrada = ''; actualizarDots(); }, 600);
    }
}

// ═══════════════════════════════════════════════
// PANTALLA 3 — REGISTRO
// ═══════════════════════════════════════════════
function seleccionarTipo(tipo) {
    tipoSesion = tipo;
    document.getElementById('btn-campo').classList.toggle('selected', tipo === 'campo');
    document.getElementById('btn-gym').classList.toggle('selected', tipo === 'gym');
    document.getElementById('btn-partido').classList.toggle('selected', tipo === 'partido');
    document.getElementById('partido-extra').style.display = tipo === 'partido' ? 'block' : 'none';
}

function actualizarRPE(val) {
    const v = parseInt(val);
    document.getElementById('rpe-display').textContent = v;
    document.getElementById('rpe-display').style.color = RPE_COLORS[v];
    document.getElementById('rpe-texto').textContent = RPE_LABELS[v];
}

const SHEETS_URL = 'https://script.google.com/macros/s/AKfycbywuocKp1rNcQbBrsSpr9pQ7yHSi9yyIusNuslI7Nq2IgOuHdGUoFccaoD9dsdHdOEz/exec';

function guardarSesion() {
    const fecha = document.getElementById('input-fecha').value;
    const rpe   = parseInt(document.getElementById('input-rpe').value);
    const cmj   = document.getElementById('input-cmj').value.trim();
    const obs   = document.getElementById('input-obs').value.trim();

    if (!tipoSesion) { mostrarAlerta('Selecciona el tipo de sesión.', 'error'); return; }
    if (!fecha)      { mostrarAlerta('Indica la fecha de la sesión.', 'error'); return; }

    const minutos = document.getElementById('input-minutos').value.trim();

    const registro = {
        jugador:  jugadorActual,
        tipo:     tipoSesion,
        fecha:    fecha,
        rpe:      rpe,
        cmj:      cmj !== '' ? parseFloat(cmj) : null,
        minutos:  minutos !== '' ? parseInt(minutos) : null,
        obs:      obs,
        ts:       Date.now()
    };

    // Guardar en localStorage (para la pantalla de evolución)
    const sesiones = getSesiones();
    sesiones.push(registro);
    saveSesiones(sesiones);

    // Enviar a Google Sheets
    const btnGuardar = document.querySelector('#screen-registro .btn');
    btnGuardar.disabled = true;
    btnGuardar.textContent = '⏳ Guardando...';

    const params = new URLSearchParams({
        jugador:  registro.jugador,
        tipo:     registro.tipo,
        fecha:    registro.fecha,
        rpe:      registro.rpe,
        cmj:      registro.cmj ?? '',
        minutos:  registro.minutos ?? '',
        obs:      registro.obs ?? ''
    });

    fetch(SHEETS_URL + '?' + params.toString(), { mode: 'no-cors' })
    .then(() => {
        mostrarAlerta('✅ Sesión guardada en Google Sheets', 'ok');
        resetFormulario();
        setTimeout(() => irA('screen-menu'), 1400);
    })
    .catch(() => {
        mostrarAlerta('⚠️ Sin conexión — guardado solo en este dispositivo', 'error');
        resetFormulario();
        setTimeout(() => irA('screen-menu'), 2000);
    })
    .finally(() => {
        btnGuardar.disabled = false;
        btnGuardar.textContent = '✅ Guardar sesión';
    });
}

function resetFormulario() {
    tipoSesion = '';
    document.getElementById('btn-campo').classList.remove('selected');
    document.getElementById('btn-gym').classList.remove('selected');
    document.getElementById('input-fecha').value = new Date().toISOString().split('T')[0];
    document.getElementById('input-rpe').value = 5;
    actualizarRPE(5);
    document.getElementById('input-cmj').value = '';
    document.getElementById('input-minutos').value = '';
    document.getElementById('partido-extra').style.display = 'none';
    document.getElementById('btn-partido').classList.remove('selected');
    document.getElementById('input-obs').value = '';
}

// ═══════════════════════════════════════════════
// PANTALLA 4 — EVOLUCIÓN
// ═══════════════════════════════════════════════
function cargarEvolucion() {
    document.getElementById('evolucion-subtitle').textContent = jugadorActual;
    renderTablaRPE();
    renderTablaCMJ();
    renderTablaPartido();
    cambiarTab('rpe');
}

let chartRPE = null;
let chartCMJ = null;

function cambiarTab(tab) {
    ['rpe','cmj','partido'].forEach(t => {
        document.getElementById('tab-' + t).classList.toggle('active', tab === t);
        document.getElementById('tab-' + t + '-btn').classList.toggle('active', tab === t);
    });
    if (tab === 'rpe') renderGraficoRPE();
    if (tab === 'cmj') renderGraficoCMJ();
    if (tab === 'partido') renderTablaPartido();
}

function renderTablaRPE() {
    const sesiones = getSesiones()
        .filter(s => s.jugador === jugadorActual)
        .sort((a, b) => new Date(b.fecha) - new Date(a.fecha));

    const cont = document.getElementById('tabla-rpe-container');

    if (sesiones.length === 0) {
        cont.innerHTML = `<div class="empty-state"><div class="empty-icon">📭</div>Aún no hay sesiones registradas.</div>`;
        return;
    }

    let html = `
        <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>RPE</th>
                    <th>Observaciones</th>
                </tr>
            </thead>
            <tbody>`;

    sesiones.forEach(s => {
        const color = RPE_COLORS[s.rpe];
        const tipoIcon = s.tipo === 'campo' ? '⚽' : '🏋️';
        const fechaStr = formatFecha(s.fecha);
        html += `
            <tr>
                <td>${fechaStr}</td>
                <td>${tipoIcon} ${capitalize(s.tipo)}</td>
                <td><span class="rpe-badge" style="background:${color}22;color:${color};border:1px solid ${color}44">${s.rpe}</span></td>
                <td class="comment-td">${s.obs || '—'}</td>
            </tr>`;
    });

    html += `</tbody></table></div>`;
    cont.innerHTML = html;
}

function renderTablaCMJ() {
    const sesiones = getSesiones()
        .filter(s => s.jugador === jugadorActual && s.cmj !== null)
        .sort((a, b) => new Date(b.fecha) - new Date(a.fecha));

    const cont = document.getElementById('tabla-cmj-container');

    if (sesiones.length === 0) {
        cont.innerHTML = `<div class="empty-state"><div class="empty-icon">📭</div>Aún no hay datos de CMJ registrados.</div>`;
        return;
    }

    // Calcular mejor marca y media
    const valores = sesiones.map(s => s.cmj);
    const mejor   = Math.max(...valores);
    const media   = (valores.reduce((a, b) => a + b, 0) / valores.length).toFixed(1);

    let html = `
        <div style="display:flex;gap:12px;margin-bottom:16px;">
            <div style="flex:1;background:#252b32;border-radius:8px;padding:14px;text-align:center;border:1px solid #3a4149;">
                <div style="font-size:11px;color:#a0a5aa;margin-bottom:4px;">MEJOR MARCA</div>
                <div style="font-size:24px;font-weight:800;color:#d1a85c;">${mejor} <small style="font-size:13px;font-weight:400;">cm</small></div>
            </div>
            <div style="flex:1;background:#252b32;border-radius:8px;padding:14px;text-align:center;border:1px solid #3a4149;">
                <div style="font-size:11px;color:#a0a5aa;margin-bottom:4px;">MEDIA</div>
                <div style="font-size:24px;font-weight:800;color:#d1a85c;">${media} <small style="font-size:13px;font-weight:400;">cm</small></div>
            </div>
        </div>
        <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>CMJ (cm)</th>
                </tr>
            </thead>
            <tbody>`;

    sesiones.forEach(s => {
        const esMejor = s.cmj === mejor;
        const tipoIcon = s.tipo === 'campo' ? '⚽' : '🏋️';
        html += `
            <tr>
                <td>${formatFecha(s.fecha)}</td>
                <td>${tipoIcon} ${capitalize(s.tipo)}</td>
                <td><strong>${s.cmj}${esMejor ? ' 🥇' : ''}</strong></td>
            </tr>`;
    });

    html += `</tbody></table></div>`;
    cont.innerHTML = html;
}

// ═══════════════════════════════════════════════
// UTILIDADES
// ═══════════════════════════════════════════════
function mostrarAlerta(msg, tipo) {
    const box = document.getElementById('alert-box');
    box.textContent = msg;
    box.style.background = tipo === 'error' ? '#c62828' : '#2e7d32';
    box.style.display = 'block';
    setTimeout(() => { box.style.display = 'none'; }, 2800);
}

function formatFecha(fechaStr) {
    if (!fechaStr) return '—';
    const [y, m, d] = fechaStr.split('-');
    return `${d}/${m}/${y}`;
}

function capitalize(str) {
    return str.charAt(0).toUpperCase() + str.slice(1);
}

// ═══════════════════════════════════════════════
// GRÁFICOS
// ═══════════════════════════════════════════════
function renderGraficoRPE() {
    const sesiones = getSesiones()
        .filter(s => s.jugador === jugadorActual)
        .sort((a, b) => new Date(a.fecha) - new Date(b.fecha));

    if (sesiones.length === 0) return;

    const labels = sesiones.map(s => formatFecha(s.fecha));
    const data   = sesiones.map(s => s.rpe);
    const colors = data.map(v => RPE_COLORS[v]);

    const ctx = document.getElementById('chart-rpe');
    if (chartRPE) chartRPE.destroy();
    chartRPE = new Chart(ctx, {
        type: 'bar',
        data: {
            labels,
            datasets: [{
                label: 'RPE',
                data,
                backgroundColor: colors,
                borderRadius: 5,
                borderSkipped: false,
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => 'RPE ' + ctx.parsed.y + ' — ' + RPE_LABELS[ctx.parsed.y]
                    }
                }
            },
            scales: {
                y: { min: 0, max: 10, ticks: { color: '#a0a5aa', stepSize: 1 }, grid: { color: '#2e353e' } },
                x: { ticks: { color: '#a0a5aa', maxRotation: 45 }, grid: { color: '#2e353e' } }
            }
        }
    });
}

function renderGraficoCMJ() {
    const sesiones = getSesiones()
        .filter(s => s.jugador === jugadorActual && s.cmj !== null)
        .sort((a, b) => new Date(a.fecha) - new Date(b.fecha));

    if (sesiones.length === 0) return;

    const labels = sesiones.map(s => formatFecha(s.fecha));
    const data   = sesiones.map(s => s.cmj);
    const mejor  = Math.max(...data);

    const ctx = document.getElementById('chart-cmj');
    if (chartCMJ) chartCMJ.destroy();
    chartCMJ = new Chart(ctx, {
        type: 'line',
        data: {
            labels,
            datasets: [{
                label: 'CMJ (cm)',
                data,
                borderColor: '#d1a85c',
                backgroundColor: 'rgba(209,168,92,0.12)',
                pointBackgroundColor: data.map(v => v === mejor ? '#ffd700' : '#d1a85c'),
                pointRadius: data.map(v => v === mejor ? 7 : 4),
                tension: 0.35,
                fill: true,
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => ctx.parsed.y + ' cm' + (ctx.parsed.y === mejor ? ' 🥇' : '')
                    }
                }
            },
            scales: {
                y: { ticks: { color: '#a0a5aa' }, grid: { color: '#2e353e' } },
                x: { ticks: { color: '#a0a5aa', maxRotation: 45 }, grid: { color: '#2e353e' } }
            }
        }
    });
}

// ═══════════════════════════════════════════════
// TABLA PARTIDOS
// ═══════════════════════════════════════════════
function renderTablaPartido() {
    const sesiones = getSesiones()
        .filter(s => s.jugador === jugadorActual && s.tipo === 'partido')
        .sort((a, b) => new Date(b.fecha) - new Date(a.fecha));

    const cont = document.getElementById('tabla-partido-container');

    if (sesiones.length === 0) {
        cont.innerHTML = '<div class="empty-state"><div class="empty-icon">🏆</div>Aún no hay partidos registrados.</div>';
        return;
    }

    const totalMinutos = sesiones.reduce((s, p) => s + (p.minutos || 0), 0);

    let html = `
        <div style="display:flex;gap:12px;margin-bottom:16px;">
            <div style="flex:1;background:#252b32;border-radius:8px;padding:14px;text-align:center;border:1px solid #3a4149;">
                <div style="font-size:11px;color:#a0a5aa;margin-bottom:4px;">TOTAL MINUTOS</div>
                <div style="font-size:24px;font-weight:800;color:#d1a85c;">${totalMinutos}<small style="font-size:13px;font-weight:400;"> min</small></div>
            </div>
    
            <div style="flex:1;background:#252b32;border-radius:8px;padding:14px;text-align:center;border:1px solid #3a4149;">
                <div style="font-size:11px;color:#a0a5aa;margin-bottom:4px;">PARTIDOS</div>
                <div style="font-size:24px;font-weight:800;color:#d1a85c;">${sesiones.length}</div>
            </div>
        </div>
        <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Minutos</th>
                    <th>RPE</th>
                    <th>Notas</th>
                </tr>
            </thead>
            <tbody>`;

    sesiones.forEach(s => {
        const color = RPE_COLORS[s.rpe];
        html += `
            <tr>
                <td>${formatFecha(s.fecha)}</td>
                <td><strong>${s.minutos !== null ? s.minutos + "'" : '—'}</strong></td>
                <td><span class="rpe-badge" style="background:${color}22;color:${color};border:1px solid ${color}44">${s.rpe}</span></td>
                <td class="comment-td">${s.obs || '—'}</td>
            </tr>`;
    });

    html += '</tbody></table></div>';
    cont.innerHTML = html;
}

